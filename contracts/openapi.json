{
  "openapi": "3.1.0",
  "info": {
    "title": "roblox-analytics-mobile API",
    "version": "0.2.0",
    "description": "Development API contract for sample data and Roblox identity sessions. Analytics credential submission remains disabled until its separate security gates are complete."
  },
  "servers": [
    {
      "url": "https://bqrr070bkf.execute-api.us-east-2.amazonaws.com",
      "description": "AWS development"
    }
  ],
  "tags": [
    { "name": "System" },
    { "name": "Sample" },
    { "name": "Authentication" },
    { "name": "Connections" }
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "getHealth",
        "tags": ["System"],
        "summary": "Check API availability",
        "responses": {
          "200": {
            "description": "The API is available",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" }
              }
            }
          }
        }
      }
    },
    "/v1/sample/home": {
      "get": {
        "operationId": "getSampleHome",
        "tags": ["Sample"],
        "summary": "Load the deterministic Home sample",
        "description": "This public development route contains no user or Roblox data.",
        "responses": {
          "200": {
            "description": "A labeled sample Home snapshot",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HomeSnapshot" }
              }
            }
          }
        }
      }
    },
    "/v1/auth/roblox/start": {
      "get": {
        "operationId": "startRobloxOAuth",
        "tags": ["Authentication"],
        "summary": "Start Roblox OAuth",
        "description": "Creates server-side one-time PKCE state and returns only the Roblox authorization URL.",
        "responses": {
          "200": {
            "description": "Roblox authorization is ready to open",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OAuthStartResponse" }
              }
            }
          },
          "503": {
            "description": "OAuth client configuration is absent or unavailable",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/v1/auth/roblox/callback": {
      "get": {
        "operationId": "completeRobloxOAuth",
        "tags": ["Authentication"],
        "summary": "Complete Roblox OAuth",
        "description": "Consumes one-time PKCE state, obtains the stable Roblox user identity, revokes the short-lived Roblox authorization, and redirects to the mobile app with a one-time exchange code.",
        "parameters": [
          { "name": "code", "in": "query", "schema": { "type": "string" } },
          { "name": "state", "in": "query", "schema": { "type": "string" } },
          { "name": "error", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the registered roblox-analytics-mobile scheme",
            "headers": {
              "Location": {
                "required": true,
                "schema": { "type": "string", "pattern": "^robloxanalyticsmobile://" }
              }
            }
          },
          "400": {
            "description": "OAuth state is malformed, expired, or already consumed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "502": {
            "description": "Roblox rejected or could not complete the OAuth exchange",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/v1/auth/session/exchange": {
      "post": {
        "operationId": "exchangeAppSession",
        "tags": ["Authentication"],
        "summary": "Exchange a one-time mobile code for an app session",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SessionExchangeRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A new opaque app session",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SessionExchangeResponse" }
              }
            }
          },
          "400": {
            "description": "Malformed exchange code",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Exchange code is expired or already consumed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/v1/auth/session": {
      "get": {
        "operationId": "getAppSession",
        "tags": ["Authentication"],
        "summary": "Read the current app session",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "The current app session",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SessionResponse" }
              }
            }
          },
          "401": {
            "description": "Session is missing, expired, or revoked",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "operationId": "logoutAppSession",
        "tags": ["Authentication"],
        "summary": "Revoke the current app session",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "204": { "description": "Session revoked" },
          "401": {
            "description": "A valid bearer token is required",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/v1/connections/analytics/validate": {
      "post": {
        "operationId": "validateAnalyticsConnection",
        "tags": ["Connections"],
        "summary": "Validate an analytics connection request",
        "description": "Scaffolded and disabled in AWS. The API does not currently inspect, call Roblox with, or persist submitted credentials.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AnalyticsConnectionRequest" }
            }
          }
        },
        "responses": {
          "400": {
            "description": "Malformed request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "501": {
            "description": "Local shape validation passed, but cloud validation is not implemented",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AnalyticsConnectionPreview" }
              }
            }
          },
          "503": {
            "description": "Credential submission is disabled in AWS development",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/NotConfiguredResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque app session token"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ok", "service", "mode"],
        "properties": {
          "ok": { "const": true },
          "service": { "const": "roblox-analytics-mobile-backend" },
          "mode": { "type": "string", "enum": ["local", "aws"] }
        }
      },
      "HomeSnapshot": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mode", "source", "freshness", "portfolio", "message"],
        "properties": {
          "mode": { "type": "string", "enum": ["sample", "connected"] },
          "source": { "type": "string", "enum": ["sample_data", "roblox_open_cloud"] },
          "freshness": { "type": "string", "enum": ["fixture", "fresh", "stale", "syncing"] },
          "asOf": { "type": "string", "format": "date-time" },
          "portfolio": { "$ref": "#/components/schemas/HomePortfolio" },
          "message": { "type": "string" }
        }
      },
      "HomePortfolio": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revenueRobux", "dailyActiveUsers", "forwardD1Retention", "averagePlaytimeMinutes"],
        "properties": {
          "revenueRobux": { "type": "number", "minimum": 0 },
          "dailyActiveUsers": { "type": "number", "minimum": 0 },
          "forwardD1Retention": { "type": "number", "minimum": 0, "maximum": 100 },
          "averagePlaytimeMinutes": { "type": "number", "minimum": 0 }
        }
      },
      "OAuthStartResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authorizationUrl"],
        "properties": {
          "authorizationUrl": {
            "type": "string",
            "pattern": "^https://apis\\.roblox\\.com/oauth/v1/authorize\\?"
          }
        }
      },
      "RobloxUserProfile": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sub"],
        "properties": {
          "sub": { "type": "string", "pattern": "^[0-9]+$" },
          "name": { "type": "string" },
          "nickname": { "type": "string" },
          "preferredUsername": { "type": "string" },
          "profileUrl": { "type": "string", "format": "uri" },
          "pictureUrl": { "type": "string", "format": "uri" }
        }
      },
      "SessionExchangeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code"],
        "properties": {
          "code": { "type": "string", "minLength": 32, "maxLength": 128, "writeOnly": true }
        }
      },
      "SessionResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expiresAt", "user"],
        "properties": {
          "expiresAt": { "type": "string", "format": "date-time" },
          "user": { "$ref": "#/components/schemas/RobloxUserProfile" }
        }
      },
      "SessionExchangeResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/SessionResponse" },
          {
            "type": "object",
            "required": ["token"],
            "properties": {
              "token": { "type": "string", "minLength": 32, "readOnly": true }
            }
          }
        ]
      },
      "AnalyticsConnectionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["apiKey", "universeIds"],
        "properties": {
          "apiKey": {
            "type": "string",
            "minLength": 10,
            "writeOnly": true,
            "description": "Dedicated Roblox Open Cloud key. Never log or return this value."
          },
          "universeIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[0-9]+$" }
          }
        }
      },
      "AnalyticsConnectionPreview": {
        "type": "object",
        "required": ["status", "scope", "universeIds", "message"],
        "properties": {
          "status": { "const": "not_configured" },
          "scope": { "const": "universe.analytics:read" },
          "universeIds": {
            "type": "array",
            "items": { "type": "string" }
          },
          "fingerprint": { "type": "string", "pattern": "^\\.\\.\\..{4}$" },
          "message": { "type": "string" }
        }
      },
      "NotConfiguredResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "message"],
        "properties": {
          "status": { "const": "not_configured" },
          "message": { "type": "string" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
