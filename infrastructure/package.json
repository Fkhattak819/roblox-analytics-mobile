{
  "name": "roblox-analytics-mobile-infrastructure",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:backend": "npm --prefix ../backend run build",
    "test": "npm run build:backend && tsx --test test/*.test.ts",
    "synth": "npm run build:backend && cdk synth",
    "diff:dev": "npm run build:backend && cdk diff --profile roblox-analytics-mobile",
    "deploy:dev": "npm run build:backend && cdk deploy --profile roblox-analytics-mobile"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.267.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "aws-cdk": "^2.1139.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
