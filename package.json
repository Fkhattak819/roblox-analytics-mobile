    "metro-config": "0.83.8",
    "metro-transform-worker": "0.83.8",
    "postcss": "8.5.28",
    "js-yaml@>=4 <5": "4.3.2",
    "decode-uri-component": "$decode-uri-component",
    "xcode": {
